source 'https://rubygems.org'

# Matches the Jekyll version and plugins GitHub Pages builds with
# (includes jekyll-paginate, jekyll-sitemap, jekyll-feed and jemoji).
gem 'github-pages', group: :jekyll_plugins

# Only needed to run the site locally on newer Ruby (3.4+), which no longer
# bundles these. GitHub Pages builds with its own Ruby and ignores them.
gem 'erb'
gem 'webrick'
gem 'csv'
gem 'base64'
gem 'bigdecimal'
gem 'logger'
